ARG PYTHON_IMAGE=python:3.12.14-slim-trixie@sha256:e5c9fa26ffb76e11e0f054f30dc2523a2f9693f0c36c0cf1e39b27e152d899fc

FROM ${PYTHON_IMAGE} AS ffmpeg-h10-build
ARG APT_MIRROR=mirrors.aliyun.com
COPY docker/ffmpeg/install-h10-build-deps.sh /usr/local/bin/install-h10-build-deps.sh
RUN chmod 0555 /usr/local/bin/install-h10-build-deps.sh \
    && /usr/local/bin/install-h10-build-deps.sh
ADD --checksum=sha256:de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f \
  https://deb.debian.org/debian/pool/main/f/ffmpeg/ffmpeg_7.1.5.orig.tar.xz \
  /opt/ffmpeg/ffmpeg_7.1.5.orig.tar.xz
ADD --checksum=sha256:a1be51d8a10744952fe94fa318bf71bbc8074bed0951382c079ab7ef227f74ef \
  https://deb.debian.org/debian-security/pool/updates/main/f/ffmpeg/ffmpeg_7.1.5-0+deb13u1.debian.tar.xz \
  /opt/ffmpeg/ffmpeg_7.1.5-0+deb13u1.debian.tar.xz
COPY docker/ffmpeg/86708357d126af84c16f80d9c57335d1e8c845c5.patch /opt/ffmpeg/
COPY docker/ffmpeg/02fc47e13f903768b75f7985a2706a6223ab4506.patch /opt/ffmpeg/
COPY docker/ffmpeg/16b2049d4d5222db6cd7c031409058571c94f6a9.patch /opt/ffmpeg/
COPY docker/ffmpeg/9d786e4b5e9b8482651928574de33772aeee7be1.patch /opt/ffmpeg/
COPY docker/ffmpeg/1c10bcc2e17255dacb717a25ab3db142ce390602.patch /opt/ffmpeg/
COPY docker/ffmpeg/1cdeb3c4e7f1f8566d846b9b451e01c376398818.patch /opt/ffmpeg/
COPY docker/ffmpeg/65b0dab903e5975e036b30ecc58f5935d4f151e0-debian-7.1.5-backport.patch /opt/ffmpeg/
COPY docker/ffmpeg/aca41d3d9327be4d6ab036f494b700118fcc04e1-ffmpeg-7.1.5-backport.patch /opt/ffmpeg/
COPY docker/ffmpeg/acf5d7cdc1f9ae8752c23e1ea8d7f355ed780781.patch /opt/ffmpeg/
COPY docker/ffmpeg/build-h10-debs.sh /usr/local/bin/build-h10-debs.sh
RUN chmod 0555 /usr/local/bin/build-h10-debs.sh \
    && /usr/local/bin/build-h10-debs.sh

FROM ${PYTHON_IMAGE}
COPY --from=ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c /uv /uvx /bin/
WORKDIR /app

# 2026-05-15 incident: apt-get install system media/build packages
# packages) hung 74+ min on deb.debian.org from China. Switch to Aliyun mirror
# before any apt-get call. Debian 13 Trixie uses deb822 format in
# sources.list.d/debian.sources, not the legacy /etc/apt/sources.list.
# Override-able via APT_MIRROR build-arg for overseas builds.
ARG APT_MIRROR=mirrors.aliyun.com
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi

# Install the only runtime system dependency. All Python packages used here
# have reviewed CPython 3.12 wheels in uv.lock, including psycopg[binary] and
# Pillow, so compiler and development headers must not remain in the image.
#   - H10 FFmpeg: the exact Debian 7.1.5 source is patched with nine
#     checksum-bound upstream fixes (two version-context backports) and built
#     without the IAMF demuxer.
#     The custom version prevents the vulnerable distribution package from
#     silently returning.
COPY --from=ffmpeg-h10-build /ffmpeg-debs /tmp/ffmpeg-debs
COPY docker/ffmpeg/verify-h10-runtime.sh /usr/local/bin/verify-h10-runtime.sh
RUN apt-get update \
    && apt-get install -y --no-install-recommends /tmp/ffmpeg-debs/*.deb \
    && apt-get install -y --no-install-recommends --only-upgrade \
      bsdutils \
      libblkid1 \
      liblastlog2-2 \
      libmount1 \
      libsmartcols1 \
      libssl3t64 \
      libuuid1 \
      login \
      mount \
      openssl \
      openssl-provider-legacy \
      util-linux \
    && check_min_source_version() { \
      package="$1"; expected_source="$2"; minimum="$3"; \
      actual_source="$(dpkg-query -W -f='${source:Package}' "$package")"; \
      actual_version="$(dpkg-query -W -f='${source:Version}' "$package")"; \
      if [ "$actual_source" != "$expected_source" ] \
        || ! dpkg --compare-versions "$actual_version" ge "$minimum"; then \
        printf 'unexpected %s source/version: %s %s (expected %s >= %s)\n' \
          "$package" "$actual_source" "$actual_version" \
          "$expected_source" "$minimum" >&2; \
        exit 1; \
      fi; \
    } \
    && check_min_source_version bsdutils util-linux '2.41.5-0+deb13u1' \
    && check_min_source_version libblkid1 util-linux '2.41.5-0+deb13u1' \
    && check_min_source_version liblastlog2-2 util-linux '2.41.5-0+deb13u1' \
    && check_min_source_version libmount1 util-linux '2.41.5-0+deb13u1' \
    && check_min_source_version libsmartcols1 util-linux '2.41.5-0+deb13u1' \
    && check_min_source_version libuuid1 util-linux '2.41.5-0+deb13u1' \
    && check_min_source_version login util-linux '2.41.5-0+deb13u1' \
    && check_min_source_version mount util-linux '2.41.5-0+deb13u1' \
    && check_min_source_version util-linux util-linux '2.41.5-0+deb13u1' \
    && check_min_source_version libssl3t64 openssl '3.5.7-1~deb13u2' \
    && check_min_source_version openssl openssl '3.5.7-1~deb13u2' \
    && check_min_source_version openssl-provider-legacy openssl '3.5.7-1~deb13u2' \
    && chmod 0555 /usr/local/bin/verify-h10-runtime.sh \
    && /usr/local/bin/verify-h10-runtime.sh \
    && rm -rf /tmp/ffmpeg-debs /usr/local/bin/verify-h10-runtime.sh \
      /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project

# Copy all backend source code
COPY src ./src
COPY scripts ./scripts
COPY configs ./configs

# Phase 0 #1 (2026-05-15): alembic migrations must travel with the image so
# scripts/run_alembic_upgrade.sh can find /app/migrations inside the running
# container. Before this, only source and dependency declaration files were in
# the image, so alembic upgrade failed with "Path doesn't exist: alembic".
COPY migrations ./migrations

# P1-15: Copy strategy_source/ and rendering/ so the container behaves
# identically to local dev. strategy_source/ contains scenario configs and
# quality thresholds; rendering/ contains Remotion templates referenced by
# remotion_assemble.py and remotion_renderer.py.
# NOTE: rendering/node_modules/ should be excluded via .dockerignore (201MB+)
# and installed inside the container if Remotion rendering runs there.
COPY strategy_source ./strategy_source
COPY rendering ./rendering

# Create output directory (used by VIDEO_OUTPUT_DIR)
RUN mkdir -p /app/output

# P3-3: Run as the same explicit numeric non-root identity as the renderer so
# the two containers can share only the Unix socket and output volumes. Debian
# runtime dependencies may already reserve UID/GID 999 (for example
# systemd-journal), so identity creation must be collision-safe and ownership
# must not depend on a mutable account/group name.
RUN (getent group 999 >/dev/null || groupadd --gid 999 appgroup) && \
    (getent passwd 999 >/dev/null || \
      useradd --uid 999 --gid 999 --no-create-home --shell /usr/sbin/nologin appuser) && \
    chown -R 999:999 /app

# Release identity is metadata-only. Keep it after all filesystem layers so a
# new reviewed SHA cannot invalidate the pinned apt and uv dependency layers.
ARG RELEASE_SOURCE_SHA
ARG APP_VERSION
LABEL org.opencontainers.image.revision="${RELEASE_SOURCE_SHA}" \
      org.opencontainers.image.version="${APP_VERSION}"

ENV PYTHONPATH=/app \
    APP_VERSION="${APP_VERSION}" \
    RELEASE_SOURCE_SHA="${RELEASE_SOURCE_SHA}"
ENV PATH="/app/.venv/bin:$PATH" \
    XDG_DATA_HOME=/usr/share
USER 999:999
EXPOSE 8001
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8001"]
