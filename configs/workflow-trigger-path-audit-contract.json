{
  "status": "stable",
  "no_token_boundary": true,
  "path_filtered_workflows": [
    {
      "path": ".github/workflows/e2e-ui.yml",
      "events": ["push", "pull_request"],
      "required_paths": [
        "web/src/**",
        "web/e2e/ui-only/**",
        "web/playwright.ui.config.ts",
        "web/package.json",
        "web/package-lock.json",
        ".github/workflows/e2e-ui.yml"
      ],
      "forbidden_paths": [
        "web/**",
        "**"
      ],
      "reason": "UI-only visual regression should run on UI source, UI specs, Playwright UI config and dependency lock changes without broad noisy triggers."
    },
    {
      "path": ".github/workflows/e2e-prod.yml",
      "events": ["push"],
      "required_paths": [
        "web/e2e/production/**",
        "web/playwright.prod.config.ts",
        "web/package.json",
        "web/package-lock.json",
        ".github/workflows/e2e-prod.yml"
      ],
      "forbidden_paths": [
        "web/**",
        "**"
      ],
      "reason": "Production E2E is a remote no-token smoke by default, so it should run on production specs, prod Playwright config and dependency lock changes only."
    },
    {
      "path": ".github/workflows/image-security-review.yml",
      "events": ["push", "pull_request"],
      "required_paths": [
        "Dockerfile.backend",
        "web/Dockerfile",
        "rendering/Dockerfile",
        "pyproject.toml",
        "uv.lock",
        "web/package-lock.json",
        "rendering/package-lock.json",
        "docker/ffmpeg/**",
        ".grype.yaml",
        ".grype-backend.yaml",
        ".grype-rendering.yaml",
        ".trivyignore.yaml",
        ".trivyignore-backend.yaml",
        ".trivyignore-rendering.yaml",
        "docker-compose.yml",
        "deploy/lighthouse/docker-compose.release.yml",
        "src/tools/safe_media.py",
        "rendering/media-safety.mjs",
        ".github/workflows/image-security-review.yml"
      ],
      "forbidden_paths": [
        "src/**",
        "web/**",
        "rendering/**",
        "**"
      ],
      "reason": "Exact image review is expensive and runs only when an image dependency, scanner policy, FFmpeg build input, or exception-justifying runtime boundary changes."
    }
  ],
  "unfiltered_workflows": [
    {
      "path": ".github/workflows/ci.yml",
      "events": ["push", "pull_request"],
      "reason": "Main CI is the broad quality gate and must not hide code/test/config changes behind path filters."
    },
    {
      "path": ".github/workflows/deploy-gh-pages.yml",
      "events": ["push"],
      "reason": "Static GitHub Pages deploy intentionally follows all main/master pushes."
    }
  ]
}
